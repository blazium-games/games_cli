# Every variable this service reads, plus its DigitalOcean and GitHub Actions secret names.
# Copy to .env and fill values. .env is gitignored. Do not put secrets in this file.
# GitHub Actions secrets: ENV_FILE, NPM_ACCESS_TOKEN
# DigitalOcean secrets: none

BLAZIUM_GAMES_CLI_VERSION=
CDN_BASEURL=
CDN_KEY=
CDN_REGION=
CDN_SECRET=
CDN_SPACE=
ENV_FILE=
NPM_ACCESS_TOKEN=
NPM_TOKEN=
SPACE_PATH=
