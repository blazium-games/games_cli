# Every variable this service reads. Copy to .env and fill values.
# .env is gitignored. Do not put secrets in this file.

BLAZIUM_GAMES_CLI_VERSION=
# Account access token for patron status and patron list. Not a deploy key.
BLAZIUM_USER_TOKEN=
CDN_BASEURL=
CDN_KEY=
CDN_REGION=
CDN_SECRET=
CDN_SPACE=
ENV_FILE=
NPM_ACCESS_TOKEN=
# Path to a games_sapi binary for chauffeur sapi validate, test and dev. Empty looks on PATH, then in the chauffeur cache.
SAPI_BINARY=
SPACE_PATH=
